#!/bin/bash
# Install each package from the named Bash array, skipping already-installed packages.
install() {
	if [[ $# -ne 1 ]]; then
		echo "Usage: install <array_name>" >&2
		return 2
	fi

	local list_name="$1"
	local declaration
	local package
	local count=0

	if ! declaration=$(declare -p "$list_name" 2>/dev/null) ||
		[[ "$declaration" != "declare -a "* ]]; then
		echo "Package list is not a Bash array: $list_name" >&2
		return 2
	fi

	local -n packages="$list_name"
	for package in "${packages[@]}"; do
		package="${package#"${package%%[![:space:]]*}"}"
		package="${package%"${package##*[![:space:]]}"}"

		[[ -z "$package" ]] && continue

		count=$((count + 1))
		tput setaf 3
		echo "Installing package nr. $count: $package"
		tput sgr0

		if pacman -Qi "$package" &> /dev/null; then
			tput setaf 2
			echo "The package $package is already installed"
			tput sgr0
		else
			tput setaf 3
			echo "  Installing package $package"
			tput sgr0
			sudo pacman -S --noconfirm --needed "$package"
		fi
	done
}
