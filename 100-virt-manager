#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/install"

list=(
	qemu-full
	libvirt
	virt-manager
	virt-install
	virt-viewer
	dnsmasq
	edk2-ovmf
	swtpm
	qemu-img
	guestfs-tools
	libosinfo
)

if ! grep -qE '(^|[[:space:]])(vmx|svm)([[:space:]]|$)' /proc/cpuinfo; then
	echo "Warning: CPU virtualization extensions (VMX/SVM) are not available." >&2
	echo "Enable virtualization support in firmware before creating accelerated VMs." >&2
fi

install list
sudo systemctl enable --now libvirtd.service
sudo virsh net-autostart default
if ! sudo virsh net-list --state-active --name | grep -Fxq default; then
	sudo virsh net-start default
fi

echo "virt-manager and libvirt are installed, and the default network is enabled."
echo "Open virt-manager and connect to QEMU/KVM."
