#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/install"

list=(
	qemu-full
	libvirt
	virt-manager
	virt-install
	virt-viewer
	dnsmasq
	edk2-ovmf
	swtpm
	qemu-img
	guestfs-tools
	libosinfo
)

if ! grep -qE '(^|[[:space:]])(vmx|svm)([[:space:]]|$)' /proc/cpuinfo; then
	echo "Warning: CPU virtualization extensions (VMX/SVM) are not available." >&2
	echo "Enable virtualization support in firmware before creating accelerated VMs." >&2
fi

install list
sudo systemctl enable libvirtd.service

echo "virt-manager and libvirt are installed. Open virt-manager and connect to QEMU/KVM."
