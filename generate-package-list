#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
output_file="${1:-$script_dir/package-lists/package-list-$(date +%y%m%d).txt}"
output_dir="$(dirname -- "$output_file")"
mkdir -p -- "$output_dir"
temporary_dir="$(mktemp -d)"
temporary_output="$(mktemp "${output_file}.tmp.XXXXXX")"

cleanup() {
	rm -f -- "$temporary_dir/pacman" "$temporary_dir/yay" \
		"$temporary_dir/flatpak" "$temporary_output"
	rmdir -- "$temporary_dir"
}
trap cleanup EXIT

: > "$temporary_dir/pacman"
: > "$temporary_dir/yay"
: > "$temporary_dir/flatpak"

extract_array_packages() {
	awk '
		function trim(value) {
			sub(/^[[:space:]]+/, "", value)
			sub(/[[:space:]]+$/, "", value)
			return value
		}
		function comment_for(line, comment) {
			if (match(line, /[[:space:]]+#/)) {
				comment = trim(substr(line, RSTART + RLENGTH))
				sub(/^#+[[:space:]]*/, "", comment)
				return comment
			}
			return ""
		}
		/^[[:space:]]*list[[:space:]]*=[[:space:]]*\(/ {
			in_list = 1
			next
		}
		in_list && /^[[:space:]]*\)/ {
			in_list = 0
			next
		}
		in_list {
			line = $0
			sub(/^[[:space:]]+/, "", line)
			if (line == "" || line ~ /^#/) {
				next
			}
			comment = comment_for(line)
			if (match(line, /[[:space:]]+#/)) {
				line = substr(line, 1, RSTART - 1)
			}
			n = split(trim(line), packages, /[[:space:]]+/)
			for (i = 1; i <= n; i++) {
				if (packages[i] != "") {
					print packages[i] "\t" comment
				}
			}
		}
	' "$1"
}

extract_pacman_commands() {
	awk '
		function trim(value) {
			sub(/^[[:space:]]+/, "", value)
			sub(/[[:space:]]+$/, "", value)
			return value
		}
		{
			line = $0
			sub(/^[[:space:]]*#.*/, "", line)
			comment = ""
			if (match(line, /[[:space:]]+#/)) {
				comment = trim(substr(line, RSTART + RLENGTH))
				sub(/^#+[[:space:]]*/, "", comment)
				line = substr(line, 1, RSTART - 1)
			}
			n = split(line, fields, /[[:space:]]+/)
			for (i = 1; i < n; i++) {
				if (fields[i] == "pacman" && fields[i + 1] == "-S") {
					for (j = i + 2; j <= n; j++) {
						if (fields[j] !~ /^-/ && fields[j] !~ /[$"]/ &&
							fields[j] != "&&" && fields[j] != ";") {
							print fields[j] "\t" comment
						}
					}
					break
				}
			}
		}
	' "$1"
}

extract_flatpak_packages() {
	awk '
		function trim(value) {
			sub(/^[[:space:]]+/, "", value)
			sub(/[[:space:]]+$/, "", value)
			return value
		}
		{
			line = $0
			line = trim(line)
			if (line == "" || line ~ /^#/) {
				next
			}

			comment = ""
			if (match(line, /[[:space:]]+#/)) {
				comment = trim(substr(line, RSTART + RLENGTH))
				sub(/^#+[[:space:]]*/, "", comment)
				line = substr(line, 1, RSTART - 1)
			}
			if (line ~ /(^|[[:space:]])flatpak[[:space:]]+install([[:space:]]|$)/) {
				n = split(line, fields, /[[:space:]]+/)
				install_seen = 0
				for (i = 1; i <= n; i++) {
					if (fields[i] == "install") {
						install_seen = 1
						continue
					}
					if (install_seen && fields[i] !~ /^-/ && fields[i] != "flathub") {
						print fields[i] "\t" comment
					}
				}
				next
			}

			if (line ~ /^#!/ || line ~ /^[[:alnum:]_.+-]+[[:space:]]*$/) {
				print trim(line) "\t" comment
			}
		}
	' "$1"
}

format_packages() {
	sort -u "$1" | awk -F '\t' '
		function print_package() {
			if (package == "") {
				return
			}
			printf "%s", package
			if (comments != "") {
				printf " # %s", comments
			}
			printf "\n"
		}
		$1 != package {
			print_package()
			package = $1
			comments = ""
		}
		$2 != "" {
			comment_key = package SUBSEP $2
			if (!seen[comment_key]++) {
				comments = comments (comments == "" ? "" : "; ") $2
			}
		}
		END {
			print_package()
		}
	'
}

for source_file in "$script_dir"/[0-9]*; do
	[[ -f "$source_file" ]] || continue

	case "$(basename "$source_file")" in
		070-*)
			extract_array_packages "$source_file" >> "$temporary_dir/yay"
			;;
		200-*)
			extract_array_packages "$source_file" >> "$temporary_dir/flatpak"
			extract_flatpak_packages "$source_file" >> "$temporary_dir/flatpak"
			;;
		*)
			extract_array_packages "$source_file" >> "$temporary_dir/pacman"
			extract_pacman_commands "$source_file" >> "$temporary_dir/pacman"
			;;
	esac
done

{
	printf '# Generated from numbered project scripts by generate-package-list.sh\n'
	printf '# These are configured package selections, not a list of installed system packages.\n\n'

	for manager in pacman yay flatpak; do
		printf '%s packages:\n' "$manager"
		format_packages "$temporary_dir/$manager"
		printf '\n'
	done
} > "$temporary_output"

chmod 0644 "$temporary_output"
mv -- "$temporary_output" "$output_file"
printf 'Package list written to %s\n' "$output_file"
